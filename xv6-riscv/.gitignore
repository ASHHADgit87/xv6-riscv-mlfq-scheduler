# Python cache files
__pycache__/
*.pyc
*.pyo

# xv6 build artifacts (compiled objects, assembly, dependencies)
xv6-riscv/*.o
xv6-riscv/*.d
xv6-riscv/*.asm
xv6-riscv/*.sym
xv6-riscv/**/*.o
xv6-riscv/**/*.d
xv6-riscv/**/*.asm
xv6-riscv/**/*.sym

# xv6 binaries and disk images
xv6-riscv/kernel/kernel
xv6-riscv/fs.img
xv6-riscv/mkfs/mkfs

# user binaries generated in xv6-riscv/user/
xv6-riscv/user/_*

# Other temporary or generated files
.DS_Store
*.swp
*.bak